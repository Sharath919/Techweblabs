{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/publishing", "schedule": "0 1 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 4 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 7 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 10 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 13 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 16 * * *" },
    { "path": "/api/cron/publishing", "schedule": "0 19 * * *" }
  ],
  "functions": {
    "app/api/generate-article/route.ts": {
      "maxDuration": 180
    },
    "app/api/cron/publishing/route.ts": {
      "maxDuration": 300
    },
    "app/api/persona/chat/route.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
